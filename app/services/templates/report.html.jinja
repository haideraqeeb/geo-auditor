<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>GEO Visibility Report — {{ website }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper: #F7F5F1;
    --paper-raised: #FCFBF9;
    --ink: #16181D;
    --slate: #5B6270;
    --slate-soft: #8A8F9A;
    --hairline: #E4E0D8;
    --signal: #2F6FED;
    --signal-soft: #E8EFFD;
    --sev-high: #C1443C;
    --sev-high-bg: #FBEAE9;
    --sev-medium: #B07A2E;
    --sev-medium-bg: #FBF1E2;
    --sev-low: #4F7A56;
    --sev-low-bg: #EAF2EC;
    --sev-info: #6B7080;
    --sev-info-bg: #EEEDEA;
    --radius: 10px;
  }
  *{ box-sizing: border-box; }
  html{ -webkit-text-size-adjust: 100%; }
  body{
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .wrap{ max-width: 860px; margin: 0 auto; padding: 56px 28px 96px; }
  a{ color: var(--signal); }

  /* ---------- Cover ---------- */
  .cover{
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-bottom: 48px;
    margin-bottom: 48px;
    border-bottom: 1px solid var(--hairline);
  }
  .eyebrow{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate);
    margin-bottom: 18px;
  }
  .site-name{
    font-family: 'Fraunces', serif;
    font-weight: 500;
    font-size: clamp(28px, 5vw, 42px);
    letter-spacing: -0.01em;
    margin: 0 0 6px;
  }
  .generated{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12.5px;
    color: var(--slate-soft);
    margin-bottom: 36px;
  }

  /* ---------- Signal Dial ---------- */
  .dial-figure{ position: relative; width: 240px; }
  .dial-score{
    position: absolute;
    left: 0; right: 0;
    top: 128px;
    text-align: center;
  }
  .dial-score .num{
    font-family: 'IBM Plex Mono', monospace;
    font-weight: 500;
    font-size: 40px;
    color: var(--ink);
  }
  .dial-score .max{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 15px;
    color: var(--slate-soft);
  }
  .dial-score .label{
    margin-top: 4px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--slate);
  }
  .dial-verdict{
    margin-top: 14px;
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 17px;
    color: var(--ink);
    max-width: 460px;
  }

  /* ---------- Category breakdown ---------- */
  .section{ margin-bottom: 48px; }
  .section-title{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate);
    margin: 0 0 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .section-title::after{
    content: "";
    flex: 1;
    height: 1px;
    background: var(--hairline);
  }
  .breakdown-row{
    display: grid;
    grid-template-columns: 150px 1fr 64px;
    align-items: center;
    gap: 14px;
    padding: 10px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .breakdown-row:last-child{ border-bottom: none; }
  .breakdown-label{ font-size: 14px; font-weight: 500; }
  .breakdown-track{
    height: 6px;
    background: var(--hairline);
    border-radius: 4px;
    overflow: hidden;
  }
  .breakdown-fill{
    height: 100%;
    background: var(--signal);
    border-radius: 4px;
  }
  .breakdown-fill.low{ background: var(--sev-high); }
  .breakdown-fill.mid{ background: var(--sev-medium); }
  .breakdown-score{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    color: var(--slate);
    text-align: right;
  }

  /* ---------- Executive summary ---------- */
  .summary-box{
    background: var(--paper-raised);
    border-left: 3px solid var(--signal);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: 24px 28px;
    font-size: 16.5px;
  }
  .summary-box p{ margin: 0; }
  .summary-box p + p{ margin-top: 12px; }

  /* ---------- Findings ---------- */
  .finding{
    background: var(--paper-raised);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 24px 26px;
    margin-bottom: 18px;
  }
  .finding-head{
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 14px;
  }
  .finding-rank{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    color: var(--slate-soft);
    padding-top: 3px;
    flex-shrink: 0;
    width: 22px;
  }
  .finding-title{
    font-family: 'Fraunces', serif;
    font-weight: 500;
    font-size: 20px;
    margin: 0;
    flex: 1;
  }
  .badges{ display: flex; gap: 8px; flex-shrink: 0; flex-wrap: wrap; }
  .badge{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 100px;
    white-space: nowrap;
  }
  .badge.sev-high{ background: var(--sev-high-bg); color: var(--sev-high); }
  .badge.sev-medium{ background: var(--sev-medium-bg); color: var(--sev-medium); }
  .badge.sev-low{ background: var(--sev-low-bg); color: var(--sev-low); }
  .badge.sev-info{ background: var(--sev-info-bg); color: var(--sev-info); }
  .badge.category{ background: var(--signal-soft); color: var(--signal); }

  .why{ margin: 0 0 18px; padding-left: 36px; color: var(--ink); }

  .evidence-list{
    list-style: none;
    margin: 0 0 18px;
    padding: 0 0 0 36px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .evidence-item{
    border-left: 2px solid var(--hairline);
    padding: 4px 0 4px 14px;
  }
  .evidence-location{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--slate);
    margin-bottom: 3px;
  }
  .evidence-observed{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13.5px;
    color: var(--ink);
    background: var(--paper);
    padding: 8px 10px;
    border-radius: 6px;
    margin: 0 0 6px;
    white-space: pre-line;
  }
  .evidence-note{
    font-size: 13.5px;
    color: var(--slate);
    margin: 0;
  }
  .evidence-note::before{ content: "→ should be: "; color: var(--slate-soft); }

  .fix{
    margin-left: 36px;
    padding-top: 14px;
    border-top: 1px dashed var(--hairline);
  }
  .fix-label{
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal);
    margin-bottom: 8px;
  }
  .fix-steps{
    font-size: 14.5px;
    white-space: pre-line;
    margin: 0 0 12px;
  }
  .copy-block{
    position: relative;
    background: var(--ink);
    border-radius: 8px;
    padding: 14px 44px 14px 14px;
  }
  .copy-block pre{
    margin: 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    color: #F2F1EC;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .copy-btn{
    position: absolute;
    top: 10px;
    right: 10px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: rgba(255,255,255,0.08);
    color: #F2F1EC;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 6px;
    padding: 5px 10px;
    cursor: pointer;
  }
  .copy-btn:hover{ background: rgba(255,255,255,0.16); }
  .copy-btn.copied{ color: #9FE3A8; border-color: #9FE3A8; }

  footer{
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--hairline);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11.5px;
    color: var(--slate-soft);
    text-align: center;
  }

  @media (max-width: 560px){
    .breakdown-row{ grid-template-columns: 100px 1fr 50px; }
    .why, .evidence-list, .fix{ padding-left: 0; margin-left: 0; }
    .finding-head{ flex-wrap: wrap; }
  }

  @media print{
    body{ background: #fff; }
    .finding{ break-inside: avoid; }
    .copy-btn{ display: none; }
  }
</style>
</head>
<body>
<div class="wrap">

  <!-- ================= COVER ================= -->
  <div class="cover">
    <div class="eyebrow">GEO Audit Report</div>
    <h1 class="site-name">{{ website }}</h1>
    <div class="generated">Generated {{ generated_at }}</div>

    {# --- Signal Dial: ScoreBreakdown has trust/content/technical/geo, each assumed 0-100.
         Overall = average of the four. cos()/sin()/pi are registered as Jinja globals
         in ReportService (not built-in filters). --- #}
    {% set trust_pct = scores.trust / 47.5 * 100 %}
    {% set content_pct = scores.content / 42.5 * 100 %}
    {% set technical_pct = scores.technical / 10 * 100 %}

    {% set categories = [
      {
        "label": "Trust",
        "percent": trust_pct
      },
      {
        "label": "Content",
        "percent": content_pct
      },
      {
        "label": "Technical",
        "percent": technical_pct
      }
    ] %}

    {% set overall = (trust_pct + content_pct + technical_pct) / 3 %}
    {% set pct = overall / 100 %}
    <div class="dial-figure">
      <svg viewBox="0 0 240 150" width="240" height="150">
        <path d="M 20 130 A 100 100 0 0 1 220 130" fill="none" stroke="var(--hairline)" stroke-width="14" stroke-linecap="round"/>
        <path d="M 20 130 A 100 100 0 0 1 220 130"
              fill="none" stroke="var(--signal)" stroke-width="14" stroke-linecap="round"
              stroke-dasharray="{{ (314 * pct)|round(1) }} 314" />
        {% for t in range(0, 11) %}
          {% set ta = pi * (t / 10) %}
          <line x1="{{ (120 - 100*cos(ta))|round(1) }}" y1="{{ (130 - 100*sin(ta))|round(1) }}"
                x2="{{ (120 - 108*cos(ta))|round(1) }}" y2="{{ (130 - 108*sin(ta))|round(1) }}"
                stroke="var(--slate-soft)" stroke-width="1.5" opacity="0.5"/>
        {% endfor %}
      </svg>
      <div class="dial-score">
        <span class="num">{{ overall|round(0)|int }}</span><span class="max">/100</span>
        <div class="label"></div>
      </div>
    </div>
  </div>

  <!-- ================= CATEGORY BREAKDOWN ================= -->
  <div class="section">
    <p class="section-title">Score breakdown</p>
    {% for cat in categories %}
    <div class="breakdown-row">
      <div class="breakdown-label">{{ cat.label }}</div>
      <div class="breakdown-track">
        <div class="breakdown-fill {% if cat.percent < 40 %}low{% elif cat.percent < 70 %}mid{% endif %}"
             style="width: {{ cat.percent }}%;"></div>
      </div>
      <div class="breakdown-score">{{ cat.percent|round(0)|int }}%</div>
    </div>
    {% endfor %}
  </div>

  <!-- ================= EXECUTIVE SUMMARY ================= -->
  <div class="section">
    <p class="section-title">What this means for you</p>
    <div class="summary-box">
      {% for para in executive_summary.split('\n') if para.strip() %}
      <p>{{ para }}</p>
      {% endfor %}
    </div>
  </div>

  <!-- ================= FINDINGS ================= -->
  <div class="section">
    <p class="section-title">Findings &amp; fixes, in the order to tackle them</p>

    {% for f in findings|sort(attribute='priority_rank') %}
    <div class="finding">
      <div class="finding-head">
        <span class="finding-rank">{{ '%02d'|format(f.priority_rank) }}</span>
        <h3 class="finding-title">{{ f.title }}</h3>
        <div class="badges">
          <span class="badge sev-{{ f.severity }}">{{ f.severity }}</span>
          <span class="badge category">{{ f.source_category }}</span>
        </div>
      </div>

      <p class="why">{{ f.why_it_matters }}</p>

      <ul class="evidence-list">
        {% for e in f.evidence %}
        <li class="evidence-item">
          <div class="evidence-location">{{ e.location }}</div>
          <p class="evidence-observed">{{ e.observed }}</p>
          <p class="evidence-note">{{ e.note }}</p>
        </li>
        {% endfor %}
      </ul>

      <div class="fix">
        <div class="fix-label">Fix it</div>
        <p class="fix-steps">{{ f.fix.steps }}</p>
        {% if f.fix.copy_paste %}
        <div class="copy-block">
          <pre>{{ f.fix.copy_paste }}</pre>
          <button class="copy-btn" onclick="copyFix(this)">Copy</button>
        </div>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>

  <footer>GEO Auditor · report generated automatically · verify before publishing</footer>
</div>

<script>
function copyFix(btn) {
  const pre = btn.previousElementSibling;
  navigator.clipboard.writeText(pre.textContent).then(() => {
    const original = btn.textContent;
    btn.textContent = "Copied";
    btn.classList.add("copied");
    setTimeout(() => { btn.textContent = original; btn.classList.remove("copied"); }, 1500);
  });
}
</script>
</body>
</html>
